# Copy to .env for local development. Never commit .env.
# On Railway these are service variables; see README.md.

# Turns on Django's debug pages and the dev-only defaults.
DEBUG=1

# Required when DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Where contact form messages go.
CONTACT_EMAIL=allenfamilybooks5@gmail.com

# How contact form emails are sent. With neither RESEND_API_KEY nor EMAIL_HOST
# set, they're printed to the console instead (the default locally).

# Resend (https://resend.com), used on Railway. Takes priority over SMTP.
RESEND_API_KEY=

# SMTP alternative. For Gmail, use an app password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# The sender address. With Resend this must be on a verified domain, e.g.
#   Allen Family Accounting <website@allenfamilyaccounting.co.uk>
# Unset, it's Resend's onboarding@resend.dev, which only delivers to the
# Resend account's own address.
DEFAULT_FROM_EMAIL=

# WhatsApp click-to-chat numbers, digits only, comma separated. Defaults to
# 447717453767. Add a second one to test the floating button's menu, e.g.
#   WHATSAPP_NUMBERS=447717453767,447747792440
WHATSAPP_NUMBERS=
